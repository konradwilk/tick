<Window x:Class="NonprofitHours.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Nonprofit Hours">
  <ScrollViewer><StackPanel Padding="24" Spacing="14" MaxWidth="800" HorizontalAlignment="Stretch">
    <TextBlock Text="Nonprofit Hours" FontSize="30" FontWeight="Bold" />
    <TextBlock x:Name="ErrorText" Foreground="Firebrick" TextWrapping="Wrap" />
    <Button Content="Data location…" Click="ChooseDataLocation" />
    <TextBlock x:Name="DataLocation" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
    <TextBlock Text="All changes are saved in this folder. Use one device at a time." TextWrapping="Wrap" />
    <StackPanel x:Name="Controls" Spacing="14">
      <TextBox x:Name="NewName" Header="New nonprofit" />
      <Button x:Name="AddButton" Content="Add nonprofit" Click="AddNonprofit" />
      <ComboBox x:Name="Nonprofits" Header="Nonprofit" DisplayMemberPath="Name" HorizontalAlignment="Stretch" />
      <TextBox x:Name="Notes" Header="Notes (optional)" />
      <TextBlock x:Name="Status" FontSize="22" TextWrapping="Wrap" />
      <Button x:Name="Toggle" Click="ToggleTracking" HorizontalAlignment="Stretch" Foreground="White" FontSize="24" />
      <TextBlock x:Name="Total" />
      <ComboBox x:Name="ReportPeriod" Header="Export period" SelectedIndex="2" SelectionChanged="ReportChanged">
        <ComboBoxItem Content="Daily" /><ComboBoxItem Content="Weekly" /><ComboBoxItem Content="Monthly" />
      </ComboBox>
      <CalendarDatePicker x:Name="ReportDate" Header="Date in the period" DateChanged="ReportDateChanged" />
      <TextBlock Text="Completed sessions by local start date. Weeks run Monday–Sunday." TextWrapping="Wrap" />
      <TextBlock x:Name="ReportSummary" TextWrapping="Wrap" />
      <Button x:Name="ExportButton" Content="Export CSV for Google Sheets" Click="Export" />
      <Button x:Name="CopyButton" Content="Copy durations and notes" Click="CopyReport" />
      <TextBlock x:Name="CopyStatus" />
      <TextBlock Text="Closing this window hides it to the system tray. Click the clock icon to reopen, or right-click it to quit. Timing continues until you press Stop." TextWrapping="Wrap" />
    </StackPanel>
    <TextBlock Text="History" FontSize="22" />
    <ItemsControl x:Name="History"><ItemsControl.ItemTemplate><DataTemplate>
      <StackPanel Spacing="6" Margin="0,0,0,14">
        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
        <Button Content="Edit notes" Tag="{Binding SessionId}" IsEnabled="{Binding CanEdit}" Click="EditNotes" />
      </StackPanel>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel></ScrollViewer>
</Window>
